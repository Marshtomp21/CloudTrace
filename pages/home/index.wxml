<view class="chat-page" wx:if="{{vm}}">
  <view class="chat-header">
    <view class="row-between chat-meta"><text class="demo-badge">固定合成样本</text><view class="history-trigger" bindtap="openHistory" aria-role="button" aria-label="查看对话记录">对话记录　›</view></view>
    <view class="context-line" bindtap="goWorkbench" aria-role="button"><view class="context-copy"><text class="context-main">{{vm.sample.area}}</text><text class="context-detail">{{vm.scenario.label}} · +{{vm.selection.leadMin}} 分钟</text></view><text class="context-arrow">›</text></view>
  </view>
  <scroll-view class="chat-scroll {{saveWarning ? 'with-save-warning' : ''}} {{isMultiline ? 'with-multiline' : ''}}" scroll-y="true" scroll-into-view="{{scrollTo}}" scroll-with-animation="true">
    <view wx:if="{{!messages.length}}" class="welcome">
      <view class="page-kicker">云迹先知 · 样本问答</view>
      <view class="welcome-title"><view>未来一小时，</view><view>先看哪里？</view></view>
      <view class="welcome-desc">从当前样本出发，查看区域影响、预测时间与判断依据。</view>
      <view class="sample-glance" bindtap="goWorkbench" aria-role="button" aria-label="查看当前样本研判">
        <view class="glance-top"><text>当前关注 · +{{vm.selection.leadMin}} 分钟</text><text>固定样本 {{vm.sample.sampleTime}}</text></view>
        <view class="glance-main"><view class="glance-copy"><text class="glance-name">{{vm.focusRegion.name}}</text><text class="glance-caption">强回波超阈值可能性</text></view><text class="glance-value">{{vm.focusRegion.probability}}%</text></view>
        <view class="glance-bottom"><text>{{vm.focusRegion.level}} · {{vm.focusRegion.arrival}}</text><text>查看研判 ›</text></view>
      </view>
      <view class="prompt-heading">可以这样问</view>
      <view class="prompt-list"><block wx:for="{{quickQuestions}}" wx:key="*this"><view class="prompt-row" data-question="{{item}}" bindtap="sendQuick" aria-role="button"><text class="prompt-index">0{{index + 1}}</text><text class="prompt-copy">{{item}}</text><text class="prompt-arrow">›</text></view></block></view>
      <view class="welcome-note">回答只依据当前固定合成样本，不提供实时预警。</view>
    </view>
    <view class="conversation"><block wx:for="{{messages}}" wx:key="id" wx:for-item="msg">
      <view id="msg-{{msg.id}}" class="message {{msg.role}}">
        <view class="message-role">{{msg.role === 'user' ? '你' : '云迹先知 · 演示'}}</view>
        <view class="message-content">
          <view wx:if="{{msg.title}}" class="answer-title">{{msg.title}}</view>
          <text class="message-text">{{msg.role === 'user' ? msg.text : msg.body}}</text>
          <view wx:if="{{msg.facts && msg.facts.length}}" class="answer-facts"><block wx:for="{{msg.facts}}" wx:key="label" wx:for-item="fact"><view class="fact-row"><text class="fact-label">{{fact.label}}</text><text class="fact-value">{{fact.value}}</text></view></block></view>
          <view wx:if="{{msg.source}}" class="answer-source">{{msg.source}}</view>
          <view wx:if="{{msg.actions && msg.actions.length}}" class="answer-actions"><block wx:for="{{msg.actions}}" wx:key="label" wx:for-item="action" wx:for-index="actionIndex"><view class="answer-link {{actionIndex === 0 ? 'primary' : ''}}" data-url="{{action.url}}" data-region="{{msg.context.regionId}}" data-lead="{{msg.context.leadMin}}" bindtap="goAction" hover-class="answer-link-pressed" aria-role="button">{{action.label}} <text>›</text></view></block></view>
        </view>
      </view>
    </block></view>
  </scroll-view>
  <view class="chat-bottom {{isMultiline ? 'multiline' : ''}}">
    <view wx:if="{{saveWarning}}" class="save-warning">对话暂未保存到本机；本次打开仍可继续使用。</view>
    <view class="composer {{isMultiline ? 'multiline' : ''}}" style="height: {{composerHeight}}rpx;">
      <textarea class="composer-input" value="{{inputText}}" bindinput="onInput" bindlinechange="onInputLineChange" placeholder="询问当前样本" placeholder-style="color:#5C717A;" maxlength="500" auto-height="true" disable-default-padding="true" adjust-position="true" show-confirm-bar="false" />
    </view>
    <view class="send-button" bindtap="send" hover-class="{{canSend ? 'send-pressed' : 'none'}}" hover-start-time="0" aria-role="button" aria-label="发送消息" aria-disabled="{{!canSend}}"><view class="send-circle {{canSend ? 'ready' : ''}}" aria-hidden="true"><image class="send-icon" src="{{canSend ? '/assets/send-plane-ready.png' : '/assets/send-plane-idle.png'}}" mode="aspectFit" /></view></view>
  </view>
</view>
<view wx:if="{{showHistory}}" class="sheet-mask" bindtap="closeHistory"><view class="bottom-sheet history-sheet" catchtap="stopMask"><view class="sheet-handle"></view><view class="row-between"><text class="sheet-title">本机对话记录</text><view class="sheet-close" bindtap="closeHistory" aria-role="button">关闭</view></view><view class="demo-note">记录只保存在当前设备，不会同步到其它设备。</view><view class="primary-button new-chat" bindtap="newChat" aria-role="button">开始新对话</view><block wx:for="{{sessions}}" wx:key="id"><view class="history-row"><view class="history-main" data-id="{{item.id}}" bindtap="selectHistory"><view class="history-title">{{item.title}} <text wx:if="{{item.active}}" class="current-mark">当前</text></view><view class="secondary-text">{{item.updatedLabel}} · {{item.count}} 轮</view></view><button class="history-delete" data-id="{{item.id}}" catchtap="deleteHistory" aria-label="删除对话">删除</button></view></block></view></view>
