.home-page{background:linear-gradient(180deg,#eef4ff 0,#f6f8fc 38%)}.topbar{align-items:flex-start}.blue,.link{color:#145cff}.live-pill{display:flex;align-items:center;gap:10rpx;background:#fff;padding:12rpx 16rpx;border-radius:999rpx;color:#5e6b82;font-size:21rpx;box-shadow:0 8rpx 18rpx rgba(30,55,100,.08)}.live-dot{width:12rpx;height:12rpx;border-radius:50%;background:#25b878;box-shadow:0 0 0 5rpx #e6f8ef}.intro{margin-top:26rpx;max-width:650rpx}.scenario-switch{margin-top:28rpx;padding:22rpx 26rpx}.scenario-name{font-size:30rpx;font-weight:680;margin-top:8rpx}.scenario-desc{color:#8993a5;font-size:21rpx;margin-top:5rpx}.switch-arrow{font-size:34rpx;color:#9aa5b7}.map-card{margin-top:18rpx;padding:22rpx 22rpx 18rpx}.map-title{display:block;font-size:29rpx;font-weight:650}.map-meta{display:block;font-size:20rpx;color:#94a1ba;margin-top:7rpx}.tag-live{background:rgba(91,151,255,.16);color:#88bcff}.weather-map{height:430rpx;position:relative;border-radius:24rpx;overflow:hidden;margin-top:18rpx;background:radial-gradient(circle at 45% 45%,#203968 0,#162642 55%,#101a2b 100%)}.map-grid{position:absolute;inset:0;opacity:.28;background-image:linear-gradient(rgba(121,162,224,.33) 1rpx,transparent 1rpx),linear-gradient(90deg,rgba(121,162,224,.33) 1rpx,transparent 1rpx);background-size:44rpx 44rpx}.map-radar{position:absolute;border-radius:50%;filter:blur(2rpx)}.radar-a{width:300rpx;height:220rpx;left:140rpx;top:100rpx;background:radial-gradient(ellipse,#ffd55f 0,#fb7147 28%,rgba(232,65,75,.02) 72%)}.radar-b{width:160rpx;height:120rpx;left:60rpx;top:54rpx;background:radial-gradient(ellipse,#53e4b2 0,#337ef6 52%,transparent 75%)}.map-zone{position:absolute;border-radius:50%;border:2rpx solid}.zone-red{width:150rpx;height:105rpx;left:345rpx;top:186rpx;background:rgba(247,80,69,.16);border-color:#ff9a78}.zone-orange{width:165rpx;height:110rpx;left:230rpx;top:76rpx;background:rgba(250,154,53,.15);border-color:#ffc56d}.zone-blue{width:190rpx;height:92rpx;left:50rpx;top:256rpx;background:rgba(64,125,246,.13);border-color:#76abff}.map-label{position:absolute;padding:8rpx 12rpx;color:#f4f8ff;background:rgba(12,30,65,.75);border-radius:11rpx;font-size:19rpx;line-height:1.3}.map-label text{font-weight:680;font-size:26rpx}.label-red{left:395rpx;top:220rpx}.label-orange{left:260rpx;top:92rpx}.label-blue{left:60rpx;top:280rpx}.map-compass{position:absolute;right:22rpx;top:18rpx;color:#b5c6e4;font-size:20rpx}.map-legend{display:flex;align-items:center;gap:18rpx;color:#98a7bf;font-size:19rpx;padding-top:15rpx}.map-legend>text{margin-left:auto}.legend-dot{display:inline-block;width:11rpx;height:11rpx;border-radius:50%;margin-right:6rpx}.legend-dot.red{background:#ff755b}.legend-dot.orange{background:#ffad56}.legend-dot.blue{background:#5b97ff}.section-gap{margin-top:36rpx;margin-bottom:16rpx}.region-list{display:flex;flex-direction:column;gap:12rpx}.region-card{display:flex;align-items:stretch;padding:0;overflow:hidden}.region-bar{width:10rpx;flex:none}.region-bar.red{background:#ed5c4e}.region-bar.orange{background:#eea33e}.region-bar.blue{background:#4a88ef}.region-main{padding:20rpx 20rpx 18rpx;flex:1}.region-name{font-size:27rpx;font-weight:650}.region-prob{font-size:30rpx;font-weight:700}.region-prob.red{color:#d94e43}.region-prob.orange{color:#c7791d}.region-prob.blue{color:#3678df}.region-sub{color:#8c96a6;font-size:20rpx;margin-top:10rpx}.tag-red{color:#c94b42;background:#ffebe8}.region-reason{display:block;color:#68758b;font-size:21rpx;margin-top:13rpx}.basis-preview{display:flex;gap:16rpx;padding:21rpx}.basis-check{width:48rpx;height:48rpx;border-radius:16rpx;background:#e3f8ee;color:#159364;display:flex;align-items:center;justify-content:center;font-size:27rpx}.basis-title{display:block;font-size:25rpx;font-weight:650}.basis-copy{display:block;color:#7e8a9e;font-size:21rpx;line-height:1.45;margin-top:6rpx}.time-row{display:flex;align-items:center;gap:12rpx;color:#99a4b5;font-size:20rpx;padding:25rpx 4rpx}.time-line{height:1rpx;background:#dce3ef;flex:1}.sheet-mask{position:fixed;inset:0;background:rgba(15,25,45,.28);z-index:10;display:flex;align-items:flex-end}.scenario-sheet{width:100%;box-sizing:border-box;background:rgba(255,255,255,.97);border-radius:34rpx 34rpx 0 0;padding:20rpx 30rpx 42rpx}.sheet-handle{width:72rpx;height:8rpx;border-radius:8rpx;background:#d7dce5;margin:0 auto 26rpx}.scenario-option{display:flex;align-items:center;gap:16rpx;padding:18rpx 4rpx;border-bottom:1rpx solid #eef1f5}.scenario-option.selected{color:#145cff}.scenario-icon{width:54rpx;height:54rpx;display:flex;align-items:center;justify-content:center;background:#edf3ff;border-radius:17rpx;color:#145cff;font-size:27rpx}.scenario-option>view:nth-child(2){flex:1}.scenario-option-title{display:block;font-size:27rpx;font-weight:620;margin-bottom:5rpx}.check{color:#145cff;font-size:30rpx}
