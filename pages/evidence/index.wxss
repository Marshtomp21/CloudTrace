.page-intro { margin-top: 12rpx; }
.conclusion-panel { position: relative; overflow: hidden; margin-top: 35rpx; padding: 31rpx 30rpx 0; color: #18323D; }
.conclusion-eyebrow { color: #607780; font-size: 23rpx; font-weight: 600; }
.conclusion-name { margin-top: 25rpx; font-size: 43rpx; line-height: 1.25; font-weight: 700; letter-spacing: -.8rpx; }
.conclusion-data { align-items: flex-end; margin: 18rpx 0 27rpx; gap: 8rpx; }
.conclusion-probability { color: #18323D; font-size: 98rpx; }
.conclusion-caption { display: block; margin-top: 7rpx; color: #5C717A; font-size: 24rpx; }
.conclusion-data .status-label { margin-bottom: 11rpx; }
.conclusion-reason { margin-top: 22rpx; color: #3F5962; font-size: 28rpx; line-height: 1.5; }
.conclusion-actions { display: flex; flex-wrap: wrap; gap: 0 32rpx; }
.conclusion-link { min-height: 88rpx; display: flex; align-items: center; color: #096B98; font-size: 28rpx; font-weight: 600; }
.section-top { margin: 51rpx 0 15rpx; }
.basis-surface { padding: 0 24rpx; border: 1rpx solid #DFE7E9; border-radius: 20rpx; background: #FFFFFF; }
.basis-row { padding: 25rpx 0; }
.basis-title { gap: 20rpx; font-size: 29rpx; font-weight: 650; }
.basis-value { color: #096B98; font-size: 26rpx; font-weight: 600; text-align: right; }
.basis-detail { margin-top: 8rpx; }
.logic-surface { padding: 0 5rpx; border-top: 1rpx solid #D6E2E5; }
.logic-row { display: flex; align-items: flex-start; gap: 20rpx; padding: 26rpx 0; border-bottom: 1rpx solid #D6E2E5; }
.step-index { width: 42rpx; height: 42rpx; display: flex; align-items: center; justify-content: center; flex: none; border-radius: 10rpx; background: #DDEDEF; color: #2F7087; font-size: 24rpx; font-weight: 700; }
.step-title { display: block; font-size: 29rpx; font-weight: 650; }
.logic-row .secondary-text { display: block; margin-top: 5rpx; }
.evidence-page { padding-bottom: calc(200rpx + env(safe-area-inset-bottom)); }
