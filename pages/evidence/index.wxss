.evidence-page{background:linear-gradient(180deg,#eef4ff 0,#f6f8fc 35%)}.page-title{margin-top:10rpx}.answer-card{margin-top:28rpx;padding:29rpx}.answer-kicker{font-size:21rpx;color:#9da9bf;letter-spacing:1rpx}.confidence-tag{background:rgba(84,220,166,.15);color:#74ddb3}.answer-title{font-size:37rpx;line-height:1.3;font-weight:680;margin-top:25rpx}.answer-copy{font-size:24rpx;color:#b7c3d8;line-height:1.6;margin-top:17rpx}.answer-foot{display:flex;justify-content:space-between;color:#8190a8;font-size:20rpx;margin-top:28rpx;padding-top:20rpx;border-top:1rpx solid rgba(255,255,255,.1)}.section-gap{margin-top:35rpx;margin-bottom:15rpx}.basis-list{display:flex;flex-direction:column;gap:12rpx}.basis-item{display:flex;gap:15rpx;padding:20rpx}.basis-icon{width:48rpx;height:48rpx;flex:none;border-radius:15rpx;background:#eaf1ff;color:#145cff;display:flex;align-items:center;justify-content:center;font-size:20rpx;font-weight:700}.basis-copy{flex:1}.basis-title{font-size:25rpx;font-weight:650}.basis-value{font-size:21rpx;color:#145cff}.basis-detail{display:block;color:#7d889b;font-size:21rpx;line-height:1.45;margin-top:7rpx}.logic-card{padding:24rpx}.logic-step{display:flex;gap:15rpx}.step-num{width:42rpx;height:42rpx;flex:none;border-radius:14rpx;background:#145cff;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700}.step-title{display:block;font-size:25rpx;font-weight:650}.step-copy{display:block;color:#7e899c;font-size:21rpx;line-height:1.45;margin-top:6rpx}.logic-line{height:26rpx;border-left:2rpx solid #cddafa;margin-left:20rpx}.limitations{padding:23rpx;margin-top:18rpx}.small-title{font-size:27rpx}.limitation-copy{display:flex;flex-direction:column;gap:11rpx;color:#7d889b;font-size:21rpx;line-height:1.45;margin-top:18rpx}
