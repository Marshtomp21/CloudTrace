<view class="page-shell evidence-page" wx:if="{{vm}}">
  <view class="page-kicker">判断依据 · 合成演示</view>
  <view class="page-heading">判断依据</view>
  <view class="secondary-text page-intro">{{vm.sample.area}} · {{vm.sample.sampleTime}} 固定合成样本</view>

  <view class="conclusion-panel surface">
    <view class="row-between"><text class="conclusion-eyebrow">所选区域判断</text><text class="conclusion-eyebrow">+{{vm.selection.leadMin}} 分钟</text></view>
    <view class="conclusion-name">{{vm.selectedRegion.name}}</view>
    <view class="conclusion-data row-between">
      <view><text class="data-value conclusion-probability">{{vm.selectedRegion.probability}}%</text><text class="conclusion-caption">强回波超阈值可能性</text></view>
      <text class="status-label {{vm.selectedRegion.statusKey}}">{{vm.selectedRegion.level}}</text>
    </view>
    <view class="divider"></view>
    <view class="conclusion-reason">{{vm.selectedRegion.reason}} · {{vm.selectedRegion.arrival}}</view>
    <view class="conclusion-actions"><view class="conclusion-link" bindtap="goRegion" aria-role="button">查看该区域 ›</view><view class="conclusion-link" bindtap="goForecast" aria-role="button">查看预测 ›</view></view>
  </view>

  <view class="section-top"><text class="section-heading">样本中的观测依据</text></view>
  <view class="basis-surface">
    <block wx:for="{{vm.basis}}" wx:key="id">
      <view class="basis-row list-row"><view class="basis-title row-between"><text>{{item.title}}</text><text class="basis-value">{{item.value}}</text></view><view class="secondary-text basis-detail">{{item.detail}}</view></view>
    </block>
  </view>

  <view class="section-top"><text class="section-heading">从观测到区域判断</text></view>
  <view class="logic-surface">
    <view class="logic-row"><text class="step-index">1</text><view><text class="step-title">识别强回波对象</text><text class="secondary-text">从样本 VIL 场提取达到阈值的连续区域。</text></view></view>
    <view class="logic-row"><text class="step-index">2</text><view><text class="step-title">估计对象移动</text><text class="secondary-text">比较相邻帧的对象位置和强度变化。</text></view></view>
    <view class="logic-row"><text class="step-index">3</text><view><text class="step-title">汇总区域可能性</text><text class="secondary-text">把对象趋势映射到预测时点和样本区域。</text></view></view>
  </view>

</view>
