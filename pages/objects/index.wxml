<view class="page-shell objects-page" wx:if="{{vm}}">
  <view class="page-kicker">区域详情 · 合成演示</view>
  <view class="page-heading">区域与回波对象</view>
  <view class="secondary-text page-intro">{{vm.sample.area}} · +{{vm.selection.leadMin}} 分钟 · 固定合成样本</view>

  <view class="section-top"><text class="section-heading">选择区域</text></view>
  <scroll-view scroll-x="true" class="region-scroll" show-scrollbar="false">
    <view class="region-tabs">
      <block wx:for="{{vm.regions}}" wx:key="id">
        <view class="region-tab {{vm.selection.regionId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectRegion" aria-role="button"><text>{{item.shortName}}</text><text class="tab-value">{{item.probability}}%</text></view>
      </block>
    </view>
  </scroll-view>

  <view class="impact-panel">
    <view class="row-between"><text class="eyebrow">+{{vm.selection.leadMin}} 分钟的影响判断</text><text class="status-label {{vm.selectedRegion.statusKey}}">{{vm.selectedRegion.level}}</text></view>
    <view class="impact-name">{{vm.selectedRegion.name}}</view>
    <view class="data-value status-value {{vm.selectedRegion.statusKey}}">{{vm.selectedRegion.probability}}%</view>
    <view class="secondary-text">强回波超阈值可能性 · 估计{{vm.selectedRegion.arrival}}进入影响窗口</view>
    <view class="divider panel-divider"></view>
    <view class="reason-heading">主要原因</view>
    <view class="body-text reason-copy">{{vm.selectedRegion.reason}}</view>
  </view>

  <view class="section-top"><text class="section-heading">回波对象</text></view>
  <view class="object-surface">
    <block wx:for="{{vm.objects}}" wx:key="id">
      <view class="object-item list-row">
        <view class="object-summary" data-id="{{item.id}}" bindtap="toggleObject" aria-role="button" aria-expanded="{{item.expanded}}">
          <view><text class="object-title">{{item.label}} <text wx:if="{{item.related}}" class="related-mark">与所选区域相关</text></text><text class="secondary-text">{{item.kind}} · {{item.movement}}</text></view>
          <text class="object-arrow {{item.expanded ? 'expanded' : ''}}">⌄</text>
        </view>
        <view class="object-detail-wrap {{item.expanded ? 'expanded' : ''}}" aria-hidden="{{!item.expanded}}">
          <view class="object-detail">
            <view class="object-metric"><text>最大 VIL</text><text>{{item.maxVil}}</text></view>
            <view class="object-metric"><text>平均 VIL</text><text>{{item.meanVil}}</text></view>
            <view class="object-metric"><text>样本面积</text><text>{{item.area}} km²</text></view>
          </view>
        </view>
      </view>
    </block>
  </view>
</view>
