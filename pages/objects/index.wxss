.objects-page{background:linear-gradient(180deg,#eef4ff 0,#f6f8fc 35%)}.page-title{margin-top:10rpx}.object-map{height:360rpx;margin-top:26rpx;position:relative;overflow:hidden;background:#162540;border:none}.map-grid{position:absolute;inset:0;opacity:.3;background-image:linear-gradient(rgba(104,151,229,.3) 1rpx,transparent 1rpx),linear-gradient(90deg,rgba(104,151,229,.3) 1rpx,transparent 1rpx);background-size:44rpx 44rpx}.map-radar{position:absolute;border-radius:50%}.radar-main{width:360rpx;height:240rpx;left:170rpx;top:80rpx;background:radial-gradient(ellipse,#ffd05c 0,#ef6a48 33%,rgba(225,65,72,.02) 74%);filter:blur(2rpx)}.map-zone{position:absolute;border:2rpx solid;border-radius:50%}.zone-red{width:150rpx;height:100rpx;left:370rpx;top:170rpx;border-color:#ff9674;background:rgba(255,80,70,.17)}.zone-orange{width:168rpx;height:110rpx;left:260rpx;top:55rpx;border-color:#ffc468;background:rgba(255,165,54,.15)}.zone-blue{width:190rpx;height:90rpx;left:48rpx;top:236rpx;border-color:#74a9ff;background:rgba(62,126,243,.12)}.map-label{position:absolute;color:#fff;background:rgba(11,28,60,.8);font-size:20rpx;border-radius:10rpx;padding:8rpx 12rpx}.label-red{left:390rpx;top:195rpx}.label-orange{left:250rpx;top:72rpx}.label-blue{left:58rpx;top:250rpx}.section-gap{margin-top:34rpx;margin-bottom:15rpx}.region-tabs{display:flex;gap:10rpx}.region-tab{flex:1;padding:16rpx 8rpx;border-radius:18rpx;background:#e9eef6;color:#7d889b;text-align:center;font-size:20rpx}.region-tab text{display:block}.region-tab text+text{font-size:27rpx;font-weight:700;margin-top:7rpx}.region-tab.active{background:#145cff;color:#fff;box-shadow:0 10rpx 20rpx rgba(20,92,255,.18)}.detail-card{padding:26rpx;margin-top:16rpx}.detail-title{font-size:33rpx;font-weight:680;margin-top:7rpx}.impact-number{font-size:74rpx;font-weight:730;letter-spacing:-3rpx;color:#d44f43;margin-top:24rpx}.impact-number text{font-size:28rpx;letter-spacing:0;margin-left:4rpx}.impact-time{display:block;color:#7d889b;font-size:21rpx;margin-top:4rpx}.divider{height:1rpx;background:#edf0f5;margin:25rpx 0 20rpx}.reason-title{font-size:23rpx;font-weight:650;margin-bottom:12rpx}.reason-line{display:flex;align-items:flex-start;gap:10rpx;color:#6f7b90;font-size:21rpx;line-height:1.4;margin-top:10rpx}.reason-dot{width:12rpx;height:12rpx;border-radius:50%;margin-top:8rpx;flex:none}.reason-dot.red{background:#ed6253}.reason-dot.orange{background:#eca33d}.reason-dot.blue{background:#4b88ed}.object-list{display:flex;flex-direction:column;gap:10rpx}.object-row{display:flex;align-items:center;padding:18rpx}.object-swatch{width:46rpx;height:46rpx;border-radius:15rpx;margin-right:15rpx}.object-swatch.hot{background:#ffe7d9}.object-swatch.new{background:#e2f8ed}.object-swatch.weak{background:#e5edff}.object-copy{flex:1}.object-name{display:block;font-size:25rpx;font-weight:650}.object-confidence{font-size:24rpx;color:#145cff;font-weight:680}.evidence-btn{width:100%;margin-top:18rpx}
