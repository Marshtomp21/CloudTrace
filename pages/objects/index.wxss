.page-intro { margin-top: 12rpx; }
.section-top { margin: 50rpx 0 16rpx; }
.region-scroll { margin: 0 -40rpx; width: auto; }
.region-tabs { display: flex; gap: 10rpx; width: max-content; padding: 0 40rpx 4rpx; }
.region-tab { box-sizing: border-box; min-width: 174rpx; min-height: 98rpx; padding: 14rpx 18rpx; border: 1rpx solid #D7E3E6; border-radius: 15rpx; background: #FFFFFF; color: #5F747C; font-size: 24rpx; }
.region-tab.selected { border-color: #096B98; background: #E4F0F4; color: #174657; }
.tab-value { display: block; margin-top: 4rpx; color: #18323D; font-size: 31rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.impact-panel { margin-top: 28rpx; padding: 30rpx; border: 1rpx solid #CFE0E4; border-radius: 22rpx; background: #E6F0F2; }
.impact-name { font-size: 42rpx; line-height: 1.22; font-weight: 700; margin: 26rpx 0 11rpx; letter-spacing: -.6rpx; }
.impact-panel .data-value { margin-bottom: 11rpx; }
.panel-divider { margin: 27rpx 0 22rpx; background: #CADDE1; }
.reason-heading { font-size: 24rpx; font-weight: 650; margin-bottom: 6rpx; color: #536E78; }
.reason-copy { font-size: 29rpx; }
.object-surface { padding: 0 24rpx; border: 1rpx solid #DFE7E9; border-radius: 20rpx; background: #FFFFFF; }
.object-summary { width: 100%; min-height: 91rpx; display: flex; align-items: center; justify-content: space-between; gap: 14rpx; }
.object-title { display: block; font-size: 30rpx; font-weight: 650; }
.related-mark { margin-left: 9rpx; color: #096B98; font-size: 22rpx; font-weight: 600; }
.object-summary .secondary-text { display: block; margin-top: 5rpx; }
.object-arrow { display: inline-block; flex: none; color: #567782; font-size: 32rpx; transition: transform 240ms cubic-bezier(.2, .8, .2, 1); }
.object-arrow.expanded { transform: rotate(180deg); }
.object-detail-wrap { max-height: 0; overflow: hidden; transition: max-height 260ms cubic-bezier(.2, .8, .2, 1), margin-bottom 260ms cubic-bezier(.2, .8, .2, 1); }
.object-detail-wrap.expanded { max-height: 220rpx; margin-bottom: 18rpx; }
.object-detail { padding: 9rpx 18rpx; border: 1rpx solid #E1EAEC; border-radius: 12rpx; background: #F4F8F8; }
.object-metric { min-height: 60rpx; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; color: #5F747C; font-size: 25rpx; }
.object-metric text+text { color: #18323D; font-weight: 650; font-variant-numeric: tabular-nums; }
