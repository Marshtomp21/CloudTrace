<view class="page-shell forecast-page" wx:if="{{vm}}">
  <view class="page-kicker">预测详情 · 合成演示</view>
  <view class="page-heading">预测时间轴</view>
  <view class="secondary-text page-intro">{{vm.sample.area}} · {{vm.sample.sampleTime}} 固定合成样本</view>

  <view class="forecast-summary">
    <view class="row-between"><text class="eyebrow">+{{vm.selection.leadMin}} 分钟 · 最高区域</text><text class="status-label {{vm.maxRegion.statusKey}}">{{vm.maxRegion.level}}</text></view>
    <view class="summary-name">{{vm.maxRegion.name}}</view>
    <view class="summary-number data-value status-value {{vm.maxRegion.statusKey}}">{{vm.maxRegion.probability}}%</view>
    <view class="secondary-text">强回波超阈值可能性</view>
  </view>

  <view class="section-top row-between"><text class="section-heading">选择时间</text><text class="secondary-text">未来 10–60 分钟</text></view>
  <view class="lead-chart">
    <view class="lead-chart-caption">各时点最高区域概率 · 固定合成样本</view>
    <view class="lead-chart-columns">
      <block wx:for="{{vm.leadViews}}" wx:key="min">
        <view class="lead-column {{vm.selection.leadMin === item.min ? 'selected' : ''}}" data-min="{{item.min}}" bindtap="chooseLead" aria-role="button" aria-label="{{vm.selection.leadMin === item.min ? '已选，' : ''}}+{{item.min}} 分钟，最高区域概率 {{item.maxProbability}}%">
          <text class="lead-column-value">{{item.maxProbability}}%</text>
          <view class="lead-column-track"><view class="lead-column-bar" style="height: {{item.maxProbability}}%"></view></view>
          <text class="lead-column-time">+{{item.min}}</text>
        </view>
      </block>
    </view>
  </view>

  <view class="section-top row-between"><text class="section-heading">区域排序</text><text class="secondary-text">+{{vm.selection.leadMin}} 分钟</text></view>
  <view class="rank-surface">
    <block wx:for="{{vm.regions}}" wx:key="id">
      <view class="rank-row list-row" data-id="{{item.id}}" bindtap="openRegion" aria-role="button">
        <view class="rank-top row-between"><text class="rank-name">{{index + 1}} · {{item.name}}</text><text class="rank-value status-value {{item.statusKey}}">{{item.probability}}%</text></view>
        <view class="bar-track"><view class="bar-fill {{item.statusKey}}" style="width: {{item.probability}}%"></view></view>
        <view class="rank-foot row-between"><text class="secondary-text">{{item.arrival}}</text><text class="status-label {{item.statusKey}}">{{item.level}} ›</text></view>
      </view>
    </block>
  </view>

</view>
