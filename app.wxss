page { background: #f5f7fb; color: #101828; font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "PingFang SC", "Helvetica Neue", sans-serif; }
.container { min-height: 100vh; box-sizing: border-box; padding: 28rpx 32rpx 180rpx; }
.nav-safe { padding-top: 20rpx; }
.eyebrow { color: #7d8799; font-size: 22rpx; letter-spacing: 2rpx; }
.title { color: #101828; font-size: 56rpx; line-height: 1.08; font-weight: 700; letter-spacing: -1.5rpx; }
.subtitle { color: #657085; font-size: 26rpx; line-height: 1.45; }
.card { background: rgba(255,255,255,.78); border: 1rpx solid rgba(255,255,255,.92); border-radius: 34rpx; box-shadow: 0 14rpx 40rpx rgba(26,43,73,.08); backdrop-filter: blur(22rpx); }
.card-dark { background: #141b2d; color: #fff; border-radius: 36rpx; box-shadow: 0 18rpx 48rpx rgba(14,23,42,.2); }
.row { display: flex; align-items: center; justify-content: space-between; }
.muted { color: #8490a4; }
.caption { font-size: 22rpx; color: #8b95a8; }
.tag { display: inline-flex; align-items: center; border-radius: 999rpx; padding: 10rpx 18rpx; font-size: 22rpx; font-weight: 600; }
.tag-blue { color: #1e6bff; background: #eaf1ff; }
.tag-green { color: #17865b; background: #e8f8ef; }
.tag-orange { color: #bd6715; background: #fff2df; }
.primary-btn { background: #1e6bff; color: #fff; border-radius: 999rpx; font-size: 28rpx; font-weight: 600; padding: 22rpx 30rpx; text-align: center; box-shadow: 0 12rpx 24rpx rgba(30,107,255,.2); }
.primary-btn::after { border: none; }
.primary-btn.button-hover { transform: scale(.97); opacity: .88; }
.ghost-btn { background: rgba(255,255,255,.7); color: #1e6bff; border: 1rpx solid #d9e4ff; border-radius: 999rpx; font-size: 26rpx; }
.section-title { font-size: 34rpx; font-weight: 700; letter-spacing: -.4rpx; }
.divider { height: 1rpx; background: #edf0f5; }
.metric-value { font-size: 48rpx; font-weight: 700; letter-spacing: -1rpx; }
.metric-label { font-size: 22rpx; color: #8a94a7; margin-top: 4rpx; }
.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
@media (prefers-reduced-motion: reduce) { .primary-btn { transition: none; } }
