page { background: #F2F5F5; color: #18323D; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; font-size: 30rpx; }
button { font-family: inherit; }
button::after { border: none; }
.page-shell { box-sizing: border-box; min-height: 100vh; padding: 36rpx 40rpx 84rpx; }
.page-kicker { display: flex; align-items: center; gap: 12rpx; margin-bottom: 14rpx; color: #397083; font-size: 23rpx; font-weight: 600; letter-spacing: 1rpx; }
.page-kicker::before { content: ''; width: 22rpx; height: 4rpx; border-radius: 4rpx; background: #1B7D9D; }
.page-heading { font-size: 54rpx; line-height: 1.16; font-weight: 700; letter-spacing: -1.5rpx; }
.section-heading { font-size: 35rpx; line-height: 1.25; font-weight: 700; letter-spacing: -.5rpx; }
.body-text { font-size: 29rpx; line-height: 1.55; }
.secondary-text { color: #5C717A; font-size: 26rpx; line-height: 1.45; }
.eyebrow { color: #607780; font-size: 23rpx; line-height: 1.35; font-weight: 600; }
.data-value { font-size: 106rpx; line-height: 1; font-weight: 600; font-variant-numeric: tabular-nums; letter-spacing: -5rpx; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.surface { background: #FFFFFF; border: 1rpx solid #DFE7E9; border-radius: 24rpx; box-shadow: 0 6rpx 20rpx rgba(28,63,75,.035); }
.divider { height: 1rpx; background: #DDE6E8; }
.demo-note { color: #5C717A; font-size: 23rpx; line-height: 1.5; }
.demo-badge { display: inline-flex; align-items: center; color: #397083; background: #E4EFF1; border-radius: 8rpx; padding: 7rpx 13rpx; font-size: 22rpx; line-height: 1.25; font-weight: 600; }
.text-link { color: #096B98; font-size: 28rpx; font-weight: 600; }
.primary-button { display: flex; align-items: center; justify-content: center; box-sizing: border-box; min-height: 88rpx; padding: 16rpx 24rpx; border-radius: 16rpx; background: #096B98; color: #FFFFFF; font-size: 29rpx; font-weight: 600; }
.secondary-button { display: flex; align-items: center; justify-content: center; box-sizing: border-box; min-height: 88rpx; padding: 16rpx 24rpx; border: 1rpx solid #C9DEE3; border-radius: 16rpx; background: #E8F1F3; color: #096B98; font-size: 29rpx; font-weight: 600; }
.list-row { box-sizing: border-box; min-height: 88rpx; padding: 22rpx 0; border-bottom: 1rpx solid #E3EBED; }
.list-row:last-child { border-bottom: 0; }
.status-label { box-sizing: border-box; flex: none; padding: 7rpx 12rpx; border-radius: 8rpx; font-size: 23rpx; line-height: 1.25; font-weight: 600; }
.status-label.critical { color: #A93E38; background: #FBECE9; }
.status-label.watch { color: #975912; background: #FCF1E1; }
.status-label.observe { color: #52717C; background: #EAF0F2; }
.status-value.critical { color: #AE3F38; }
.status-value.watch { color: #9B5C15; }
.status-value.observe { color: #526F7A; }
.sheet-mask { position: fixed; inset: 0; z-index: 120; display: flex; align-items: flex-end; background: rgba(12,33,42,.38); }
.bottom-sheet { box-sizing: border-box; width: 100%; max-height: 78vh; overflow-y: auto; padding: 24rpx 40rpx calc(36rpx + env(safe-area-inset-bottom)); border-radius: 26rpx 26rpx 0 0; background: #FFFFFF; box-shadow: 0 -12rpx 36rpx rgba(11,36,47,.1); }
.sheet-handle { width: 58rpx; height: 6rpx; margin: 0 auto 24rpx; border-radius: 999rpx; background: #CAD8DC; }
.sheet-title { font-size: 35rpx; font-weight: 700; }
.sheet-close { min-width: 88rpx; min-height: 88rpx; display: flex; align-items: center; justify-content: flex-end; color: #096B98; font-size: 28rpx; }
