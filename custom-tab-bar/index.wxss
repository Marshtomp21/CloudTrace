.tabbar-space { height: calc(138rpx + env(safe-area-inset-bottom)); }
.tabbar { box-sizing: border-box; position: fixed; z-index: 100; left: 50%; bottom: calc(18rpx + env(safe-area-inset-bottom)); transform: translateX(-50%); width: 500rpx; max-width: calc(100vw - 56rpx); min-height: 106rpx; padding: 7rpx; display: flex; align-items: stretch; overflow: hidden; border: 1rpx solid rgba(73,93,104,.16); border-top-color: rgba(255,255,255,.62); border-left-color: rgba(255,255,255,.38); border-bottom-color: rgba(73,93,104,.2); border-radius: 999rpx; background-color: rgba(255,255,255,.1); background-image: linear-gradient(165deg, rgba(255,255,255,.14), rgba(255,255,255,0) 48%, rgba(255,255,255,.02)); -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px); box-shadow: 0 10rpx 24rpx rgba(23,42,52,.13), 0 2rpx 6rpx rgba(23,42,52,.06), inset 0 1rpx 0 rgba(255,255,255,.55); }
.tabbar-track { position: relative; display: flex; flex: 1; min-width: 0; }
.tab-indicator { box-sizing: border-box; position: absolute; top: 0; bottom: 0; left: 0; width: 33.333333%; border: 1rpx solid rgba(255,255,255,.38); border-radius: 999rpx; background: rgba(255,255,255,.1); box-shadow: inset 0 1rpx 0 rgba(255,255,255,.55), 0 2rpx 6rpx rgba(23,42,52,.07); pointer-events: none; }
.tab-indicator.animated { transition: transform 220ms cubic-bezier(.22,.78,.2,1); }
.tab-item { box-sizing: border-box; position: relative; z-index: 1; flex: 1; min-width: 0; min-height: 90rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 999rpx; color: #526A74; transition: color 180ms ease; }
.tab-item.selected { color: #096B98; }
.tab-icon-wrap { position: relative; width: 43rpx; height: 43rpx; }
.tab-icon { position: absolute; top: 0; left: 0; width: 43rpx; height: 43rpx; transition: opacity 180ms ease, transform 220ms cubic-bezier(.22,.78,.2,1); }
.icon-idle { opacity: 1; transform: scale(1); }
.icon-active { opacity: 0; transform: scale(.92); }
.tab-item.selected .icon-idle { opacity: 0; transform: scale(.92); }
.tab-item.selected .icon-active { opacity: 1; transform: scale(1); }
.tab-label { margin-top: 2rpx; font-size: 23rpx; line-height: 1.15; font-weight: 600; }
@media (prefers-reduced-transparency: reduce) { .tabbar { border-color: #D7E4E7; background-color: #FFFFFF; background-image: none; -webkit-backdrop-filter: none; backdrop-filter: none; } }
